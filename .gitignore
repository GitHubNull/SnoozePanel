# SnoozePanel .gitignore

# ── 临时目录 ────────────────────────────────────────────
# tmp/ 是唯一临时目录：构建产物、验证截图、设备清单导出、
# 一次性辅助脚本、垃圾数据、敏感信息全在这里，一律不入库。
tmp/

# ── 敏感信息红线（即使 tmp/ 规则被改动也绝不入库）────────
tmp/HA_info.txt
tmp/HA_PROJECT_NOTES.md
tmp/tools/
tmp/ha_inventory/
*.token
*.key
*.pem

# ── 测试基建（必须入库，供他人测试/核对/验证）──────────
# dev/ 为 mock 抓测页源码，不得忽略。

# ── Node / 构建 ─────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo
.vite/

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── 日志与编辑器 ────────────────────────────────────────
*.log
.idea/
.vscode/
.qoder/
.DS_Store
Thumbs.db
