{
  "name": "snoozepanel",
  "version": "0.8.0",
  "description": "Home Assistant dashboard screensaver (lock screen) plugin",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
